<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verification Failed - Scope Engagement</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-50 font-sans">
    <div class="min-h-screen flex flex-col items-center justify-center p-4">
        <!-- Main Card -->
        <div class="max-w-md w-full bg-white rounded-lg shadow-md overflow-hidden relative">


            <!-- Header with Logo -->
            <div class="pt-8 pb-6 px-6 text-center">
                <img src="https://scopedatax.s3.ap-south-1.amazonaws.com/logo_scope.png" alt="Scope Engagement Logo"
                    class="h-12 mx-auto mb-2" />
            </div>

            <!-- Colored Divider -->
            <div class="h-1 bg-red-500 w-full"></div>

            <!-- Content Section -->
            <div class="px-8 py-8">
                <!-- Error Icon -->
                <div class="flex justify-center mb-6">
                    <div class="bg-red-100 rounded-full p-3">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-red-600" fill="none"
                            viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </div>
                </div>

                <!-- Main Content -->
                <div class="text-center">
                    <h1 class="text-2xl font-bold text-gray-800 mb-4">Verification Failed</h1>

                    <div class="bg-gray-50 border border-gray-200 rounded-md p-4 mb-6">
                        <p class="text-gray-600 mb-2">The verification link has expired or is invalid.</p>
                        <p class="text-red-500 font-medium break-all">
                            <%= error_message %>
                        </p>
                    </div>

                    <!-- Instructions -->
                    <div class="text-left text-gray-600 mb-6">
                        <h2 class="font-medium text-gray-800 mb-2">How to Proceed:</h2>
                        <ul class="space-y-2">
                           
                            <li class="flex items-start">
                                <span class="text-red-500 mr-2">•</span>
                                <span>Ensure you're using the latest link received in your inbox.</span>
                            </li>
                            <li class="flex items-start">
                                <span class="text-red-500 mr-2">•</span>
                                <span>If the issue persists, please reach out to our support team.</span>
                            </li>
                        </ul>
                    </div>

                </div>
            </div>

            <!-- Support Info -->
            <div class="bg-gray-50 px-8 py-4 border-t border-gray-200">
                <div class="text-center">
                    <p class="text-sm text-gray-600 mb-1">Need help? Contact our support team:</p>
                    <a href="mailto:contact@scope-engagement.sumagodemo.com"
                        class="text-blue-600 hover:text-red-700 text-sm font-medium">
                        contact@scope-engagement.sumagodemo.com
                    </a>
                </div>
            </div>

            <!-- Footer -->
            <div class="px-8 py-4 text-center">
                <p class="text-xs text-gray-500">
                    © 2025 Scope Engagement. All rights reserved.
                </p>
            </div>
        </div>
    </div>
</body>

</html>